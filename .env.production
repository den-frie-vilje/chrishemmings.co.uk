# Public build-time env for production builds (the default mode:
# plain `pnpm build`, and deploy/Dockerfile with VITE_MODE=production).
PUBLIC_SITE_URL=https://chrishemmings.co.uk
PUBLIC_GITHUB_REPO=den-frie-vilje/chrishemmings.co.uk

# Build markers — CI passes real values via --build-arg (process
# env wins over these mode-file defaults); empty in local builds.
PUBLIC_GIT_SHA=
PUBLIC_BUILD_TIME=
