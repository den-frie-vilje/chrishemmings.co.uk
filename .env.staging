# Public build-time env baked into staging images
# (deploy/Dockerfile runs `pnpm build --mode staging`).
# Canonicals, OG URLs and the sitemap origin point at the staging
# host so the staging build is self-consistent; the staging front
# door adds X-Robots-Tag: noindex (see deploy/Caddyfile.staging).
PUBLIC_SITE_URL=https://chrishemmings-co-uk.stage.denfrievilje.dk
PUBLIC_GITHUB_REPO=den-frie-vilje/chrishemmings.co.uk

# Build markers — CI passes real values via --build-arg (process
# env wins over these mode-file defaults); empty in local builds.
PUBLIC_GIT_SHA=
PUBLIC_BUILD_TIME=
